{
    "asciidoc.use_asciidoctor_js": true,
    "asciidoc.preview.use_asciidoctor_js": true,
    "asciidoc.preview.attributes": {
        "source-highlighter": "rouge",
        "icons": "font",
        "toc": "left",
        "lang": "ru"
    },
    "asciidoc.preview.style": "",
    "editor.rulers": [80, 100],
    "editor.wordWrap": "on",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "spellright.language": ["en", "ru"],
    "spellright.documentTypes": ["asciidoc", "markdown"]
}